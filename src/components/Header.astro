---
interface Props {
  nav?: string;
}

const { nav } = Astro.props;
const current = (name: string) => (nav === name ? "page" : undefined);
---
<header class="site-head">
  <div class="wrap">
    <a class="brand" href="/index.html">
      <span class="glyph" aria-hidden="true">
        <svg viewBox="0 0 26 26" fill="none"><path d="M3 23 A 10 10 0 0 1 23 23" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M8 23 A 5 5 0 0 1 18 23" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="13" cy="23" r="1.6" fill="currentColor"/></svg>
      </span>
      <span>
        <span class="bname">Youth Justice Project</span><br />
        <span class="bsub">A DC Youth Justice Coalition</span>
      </span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      <span>Menu</span>
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
    </button>
    <nav class="nav" id="primary-nav" aria-label="Primary">
      <a class="navlink" href="/index.html#about">About</a>
      <a class="navlink" href="/index.html#work">Our Work</a>
      <a class="navlink" href="/members.html" aria-current={current("members")}>Members</a>
      <a class="navlink" href="/policy.html" aria-current={current("policy")}>Policy &amp; Research</a>
      <a class="navlink" href="/data.html" aria-current={current("data")}>Data</a>
      <a class="navlink" href="/news.html" aria-current={current("news")}>News</a>
      <a class="navlink" href="/contact.html" aria-current={current("contact")}>Contact</a>
      {nav === "data"
        ? <a class="btn" href="/index.html">Home <span class="arw">→</span></a>
        : <a class="btn" href="/data.html">Read the data <span class="arw">→</span></a>}
    </nav>
  </div>
</header>
