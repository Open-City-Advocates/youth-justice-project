---
import Base from "../layouts/Base.astro";
import { PAGES, news } from "../lib/site";

const items = news();
---
<Base {...PAGES.news} nav="news">
<!-- ============ PAGE HERO ============ -->
<section class="page-hero">
  <div class="wrap">
    <span class="kicker">News</span>
    <h1 style="margin-top:16px;">What the coalition is filing, signing, and testifying on.</h1>
    <p class="lede">The latest from the Youth Justice Project: coalition letters, joint comments, testimony, and the policy fights moving through the District right now.</p>
  </div>
</section>

<!-- ============ LATEST ============ -->
<section class="section-sm">
  <div class="wrap">
    <div class="news-list">
{items.map((item) => (
      <a class="news-item" href={item.url}>
        <div class="nidate">{item.date}</div>
        <div>
          <h3>{item.title}</h3>
          <p>{item.summary}</p>
          <div class="nitags"><span class="dtag type">{item.type}</span>{item.tags.map((tag) => <span class="dtag">{tag}</span>)}</div>
        </div>
        <div class="ngo">Read <span class="arw">&rarr;</span></div>
      </a>
))}
    </div>

    <p class="note-strip">This is the start of the coalition's public news feed. As members file new letters, comments, and testimony, they will appear here and in <a class="textlink" href="policy.html">Policy &amp; Research</a>.</p>
  </div>
</section>

</Base>
